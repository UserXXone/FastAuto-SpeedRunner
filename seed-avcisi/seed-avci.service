[Unit]
Description=FastAuto seed avcisi (VDS = pc 6, 4 cekirdek; toplam PC panelden)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/FastAuto-SpeedRunner/seed-avcisi
# Toplam PC sayısını panel yazar (toplam.env); dosya yoksa 64.
Environment=TOPLAM=64
EnvironmentFile=-/root/FastAuto-SpeedRunner/seed-avcisi/toplam.env
ExecStart=/root/FastAuto-SpeedRunner/seed-avcisi/bin/seed-avcisi --pc 6 --toplam ${TOPLAM} --cekirdek 4 --sessiz
# Durdururken SIGTERM gelir; program sonuçları kaydedip kapanır.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
